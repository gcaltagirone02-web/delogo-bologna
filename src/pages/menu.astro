---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MenuList from '../components/MenuList.astro';

import { Image } from 'astro:assets';
import imgMezze from '../asset/images/greek-mezze.png';
import imgChairs from '../asset/images/greek-chairs.png';
import imgView from '../asset/images/aegean-view.png';

const menuEntries = await getCollection('menu', ({ id }) => {
  return id.replace(/\\/g, '/').startsWith('it/');
});

menuEntries.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const { currentLocale } = Astro;
const isIt = currentLocale === 'it' || currentLocale === undefined;

const title = isIt ? "Menù – Delogo Cucina Greca" : "Menu – Delogo Greek Cuisine";
const description = isIt 
    ? "Scopri il nostro menù autentico: antipasti tipici, secondi piatti della tradizione e vini greci selezionati."
    : "Discover our authentic menu: traditional starters, classic main courses, and selected Greek wines.";

const introText = isIt
    ? "Cucinare per qualcuno è un atto d'amore. Benvenuti al nostro tavolo, dove i sapori dell'Egeo incontrano il calore di Bologna. Lasciatevi guidare dai profumi e dalla tradizione."
    : "Cooking for someone is an act of love. Welcome to our table, where the flavors of the Aegean meet the warmth of Bologna. Let yourself be guided by aromas and tradition.";
---

<Layout title={title} description={description}>
	<Header theme="menu" />

	<!-- Skip Link for Accessibility -->
	<a href="#menu-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg">
		{isIt ? 'Vai al menù' : 'Skip to menu'}
	</a>

	<main class="pb-16 md:pb-20 bg-paper" id="menu-content">
		<!-- Spacer: dynamically sized to match header height -->
		<div id="header-spacer" class="w-full"></div>

		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center pt-8 md:pt-32 pb-6 md:pb-12 reveal-on-scroll">
				<h1 class="text-4xl md:text-7xl mb-4 md:mb-8 font-marcellus text-accent tracking-wide uppercase">
                    {isIt ? 'Il Nostro Menù' : 'Our Menu'}
                </h1>
				<p class="max-w-2xl mx-auto text-lg md:text-2xl font-marcellus italic text-slate/70 leading-relaxed px-4">
                    "{introText}"
                </p>
			</div>

            <!-- Bento Imagery Grid -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6 mb-16 md:mb-32 reveal-on-scroll">
                <div class="col-span-2 row-span-2 overflow-hidden rounded-2xl md:rounded-[2rem] border border-primary/5 group shadow-sm">
                    <Image src={imgMezze} alt="Tradizione Greca" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                </div>
                <div class="col-span-1 overflow-hidden rounded-2xl md:rounded-[2rem] border border-primary/5 aspect-[4/5] group shadow-sm">
                    <Image src={imgChairs} alt="Calore Mediterraneo" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                </div>
                <div class="col-span-1 overflow-hidden rounded-2xl md:rounded-[2rem] border border-primary/5 aspect-[4/5] group shadow-sm">
                    <Image src={imgView} alt="Orizzonti dell'Egeo" class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
                </div>
                <div class="col-span-2 h-32 md:h-48 bg-primary/5 rounded-2xl md:rounded-[2rem] flex items-center justify-center p-6 text-center border border-dashed border-primary/20">
                    <p class="font-marcellus text-primary/60 italic text-sm md:text-lg">
                        {isIt ? 'Un viaggio tra i sapori autentici di Creta e delle Isole.' : 'A journey through the authentic flavors of Crete and the Islands.'}
                    </p>
                </div>
            </div>
			
            <!-- Organic Category Navigation -->
            <nav 
				id="category-nav-wrapper"
				class="sticky z-40 mb-10 md:mb-20 w-full transform-gpu scroll-fade-edges"
				style="top: calc(var(--header-h, 121px) + 4px); transition: top 500ms ease-in-out; will-change: top;"
				role="navigation" 
				aria-label="Categorie menù"
			>
				<div class="py-2 md:py-4 flex justify-center items-center w-full bg-paper/80 backdrop-blur-sm border-y border-primary/5">
					<div 
						id="category-nav" 
						class="flex gap-2 md:gap-4 overflow-x-auto hide-scrollbar max-w-full touch-pan-x scroll-smooth px-6 md:px-10 scroll-snap-x"
						style="-webkit-overflow-scrolling: touch;"
					>
                        {menuEntries.map((entry, i) => (
                                <a 
                                href={`#${entry.data.title.toLowerCase().replace(/\s+/g, '-').replace(/&/g, '')}`}
                                class="category-pill font-marcellus uppercase tracking-widest text-[11px] md:text-sm whitespace-nowrap px-4 md:px-8 py-2.5 md:py-3.5 rounded-full flex items-center justify-center min-h-[44px] select-none snap-center transition-all duration-300"
                                data-category={entry.data.title.toLowerCase().replace(/\s+/g, '-').replace(/&/g, '')}
                            >
                                {entry.data.title}
                            </a>
                        ))}
					</div>
				</div>
            </nav>

			<div class="space-y-10 md:space-y-16">
				{menuEntries.map(entry => (
					<MenuList 
                        id={entry.data.title.toLowerCase().replace(/\s+/g, '-').replace(/&/g, '')}
                        title={entry.data.title} 
                        items={entry.data.items} 
                    />
				))}
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<style is:global>
	/* Hide scrollbar on category nav */
	.hide-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	.hide-scrollbar::-webkit-scrollbar {
		display: none;
	}

	/* ── Organic Navigation Styles ── */
	#category-nav-wrapper {
		/* Minimalist strip look */
	}

	.category-pill {
		color: var(--color-slate);
		opacity: 0.6;
	}

	.category-pill:hover {
		opacity: 1;
		color: var(--color-primary);
	}

	.category-pill.is-active {
		opacity: 1;
		color: var(--color-primary);
		background-color: color-mix(in srgb, var(--color-primary) 10%, transparent);
		/* The organic shape utility is applied via JS/added below */
		border-radius: 68% 32% 44% 56% / 46% 52% 48% 54%;
	}

	/* ── Reveal on Scroll ── */
	.reveal-on-scroll {
		opacity: 0;
		transform: translateY(30px);
		transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
        will-change: transform, opacity;
	}

	.reveal-on-scroll.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	/* Reduced motion */
	@media (prefers-reduced-motion: reduce) {
		.category-pill, .reveal-on-scroll {
			transition: none !important;
            opacity: 1 !important;
            transform: none !important;
		}
	}
</style>

<script>
	let headerMaxH = 121;
	let headerMinH = 70;

	// ── Pre-calculate exact heights for fluid 60fps animations ──
	function measureHeaderHeights() {
		const header = document.getElementById('main-header');
		if (!header) return;

		// Clone header to safely measure both states instantly without any visual flickering
		const clone = header.cloneNode(true) as HTMLElement;
		clone.style.visibility = 'hidden';
		clone.style.position = 'fixed';
		clone.style.transition = 'none';
        
        // Disable transitions on all children of clone so we can measure the final state instantly
        const allElements = clone.querySelectorAll('*');
        allElements.forEach(el => {
            (el as HTMLElement).style.transition = 'none';
        });

		document.body.appendChild(clone);

		// Measure full size
		clone.classList.remove('is-scrolled');
		headerMaxH = clone.getBoundingClientRect().height;

		// Measure compact size
		clone.classList.add('is-scrolled');
		headerMinH = clone.getBoundingClientRect().height;

		document.body.removeChild(clone);
	}

	function applyHeaderHeights() {
		const header = document.getElementById('main-header');
		const spacer = document.getElementById('header-spacer');
		if (!header) return;

		if (spacer) {
            // Spacer always holds the max height to prevent page layout shifts
            const current = parseFloat(spacer.style.height) || 0;
            if (headerMaxH > current) spacer.style.height = `${headerMaxH}px`;
        }

		const isScrolled = header.classList.contains('is-scrolled');
		document.documentElement.style.setProperty('--header-h', `${isScrolled ? headerMinH : headerMaxH}px`);
	}

	function syncHeaderHeight() {
		const header = document.getElementById('main-header');
		if (!header) return;

		measureHeaderHeights();
		applyHeaderHeights();

		// Watch for class toggle to instantly set target height variable
		// Native CSS "transition: top 500ms ease-in-out" ensures zero JS layout-thrashing on scroll
		new MutationObserver(() => {
			applyHeaderHeights();
		}).observe(header, { attributes: true, attributeFilter: ['class'] });

		// Re-measure on orientation change / resize
        let resizeTimer: ReturnType<typeof setTimeout>;
		window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
			    measureHeaderHeights();
			    applyHeaderHeights();
            }, 100);
		}, { passive: true });
	}

	// ── ScrollSpy: highlight the active category pill ──
	function initScrollSpy() {
		const pills = document.querySelectorAll<HTMLAnchorElement>('.category-pill');
		const nav = document.getElementById('category-nav');
		if (!pills.length || !nav) return;

		// Build section map from pills (preserves DOM order)
		const sections: HTMLElement[] = [];
		pills.forEach(pill => {
			const id = pill.dataset.category;
			if (id) {
				const el = document.getElementById(id);
				if (el) sections.push(el);
			}
		});
		if (!sections.length) return;

		let currentActive: string | null = null;

		function setActive(id: string) {
			if (id === currentActive) return;
			currentActive = id;

			pills.forEach(pill => {
				const isActive = pill.dataset.category === id;
				pill.classList.toggle('is-active', isActive);
				pill.setAttribute('aria-current', isActive ? 'true' : 'false');

				// Auto-scroll the active pill into view horizontally
				if (isActive && nav) {
					const navRect = nav.getBoundingClientRect();
					const scrollLeft = (pill as HTMLElement).offsetLeft
						- nav.offsetLeft
						- (navRect.width / 2)
						+ ((pill as HTMLElement).offsetWidth / 2);
					nav.scrollTo({ left: scrollLeft, behavior: 'smooth' });
				}
			});
		}

		// ── Position-based scroll-spy ──
		// Finds which section's top is closest to — but still above — a detection
		// line at 35% from the top of the viewport. Works reliably regardless of
		// section height (fixes IntersectionObserver miss on short sections like SECONDI).
		function findActiveSection(): string {
			const headerH = parseFloat(
				getComputedStyle(document.documentElement).getPropertyValue('--header-h')
			) || 100;
			// Detection line: header bottom + half the remaining space
			const triggerY = window.scrollY + headerH + (window.innerHeight - headerH) * 0.25;

			let activeId = sections[0].id;
			for (const section of sections) {
				if (section.offsetTop <= triggerY) {
					activeId = section.id;
				}
			}
			return activeId;
		}

		// Update on scroll (throttled with requestAnimationFrame)
		let rafPending = false;
		function onScroll() {
			if (rafPending) return;
			rafPending = true;
			requestAnimationFrame(() => {
				setActive(findActiveSection());
				rafPending = false;
			});
		}

		window.addEventListener('scroll', onScroll, { passive: true });

		// Immediate feedback on pill click (don't wait for scroll)
		pills.forEach(pill => {
			pill.addEventListener('click', () => {
				const id = pill.dataset.category;
				if (id) setActive(id);
			});
		});

		// Set initial active state
		setActive(findActiveSection());
	}

    // ── Intersection Observer for Reveal ──
    function initRevealOnScroll() {
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    // Stop observing once visible to prevent re-triggering
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal-on-scroll').forEach(el => {
            observer.observe(el);
        });
    }

	// ── Initialization ──
	// Measure in three phases to always capture late-loading web fonts (like Cormorant Garamond)
	// Phase 1: DOMContentLoaded
	document.addEventListener('DOMContentLoaded', () => {
		syncHeaderHeight();
		initScrollSpy();
        initRevealOnScroll();
	});

	// Phase 2: Fonts ready
	document.fonts.ready.then(() => {
		measureHeaderHeights();
		applyHeaderHeights();
	});

	// Phase 3: Window load
	window.addEventListener('load', () => {
		measureHeaderHeights();
		applyHeaderHeights();
	});
</script>
