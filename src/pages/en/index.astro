---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/Hero.astro";
import StarDishes from "../../components/StarDishes.astro";
import MenuAccordion from "../../components/MenuAccordion.astro";
import LocationBlock from "../../components/LocationBlock.astro";
import { Image } from "astro:assets";
import imgAegean from "../../asset/images/aegean-view.png";
import imgMezze from "../../asset/images/greek-mezze.png";
import imgChairs from "../../asset/images/greek-chairs.png";
const title = "Delogo – Authentic Greek Cuisine in Bologna";
const description =
  "Authentic Greek restaurant in the heart of Bologna. Traditional dishes: Moussakas, Suvlaki, Tzatziki, and more.";
---

<Layout title={title} description={description}>
  <Header />
  <main class="bg-paper" id="main-content">
    <Hero />

    <!-- USP Section: Why Delogo (Bento Grid) -->
    <section id="about" class="py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-4xl md:text-6xl text-center mb-16 font-marcellus text-primary uppercase tracking-wider"
        >
          A Taste of the Aegean
        </h2>

        <div class="space-y-32 mt-20">
          <!-- Chapter 1: L'Origine -->
          <div
            class="flex flex-col-reverse md:flex-row items-center gap-12 md:gap-24 group reveal-on-scroll"
          >
            <div
              class="w-full md:w-1/2 overflow-hidden rounded-3xl shadow-lg relative aspect-[4/3] border border-primary/5"
            >
              <Image
                src={imgAegean}
                alt="Aegean landscapes and flavors"
                class="w-full h-full object-cover scale-[1.03] transition-transform duration-1000 group-hover:scale-110"
              />
            </div>
            <div class="w-full md:w-1/2 space-y-6">
              <span
                class="text-accent font-bold tracking-widest uppercase text-sm mb-2 block font-marcellus"
                >Chapter I</span
              >
              <h3
                class="text-4xl md:text-5xl font-marcellus text-gray-900 leading-tight"
              >
                Our Philosophy
              </h3>
              <p class="text-xl text-slate/80 leading-relaxed font-sans italic">
                We bring the authentic recipes of the Greek islands to Bologna,
                where we learned that to eat well you need sun, sea, and
                dedication. We want you to taste the real Greece and its culture
                of hospitality, without needing to catch a flight.
              </p>
            </div>
          </div>

          <!-- Chapter 2: Gli Ingredienti -->
          <div
            class="flex flex-col-reverse md:flex-row-reverse items-center gap-12 md:gap-24 group reveal-on-scroll"
          >
            <div
              class="w-full md:w-1/2 overflow-hidden rounded-3xl shadow-lg relative aspect-[4/3] border border-primary/5"
            >
              <Image
                src={imgChairs}
                alt="Authentic Greek atmosphere"
                class="w-full h-full object-cover scale-[1.03] transition-transform duration-1000 group-hover:scale-110"
              />
            </div>
            <div class="w-full md:w-1/2 space-y-6 text-left md:text-right">
              <span
                class="text-accent font-bold tracking-widest uppercase text-sm mb-2 block font-marcellus"
                >Chapter II</span
              >
              <h3
                class="text-4xl md:text-5xl font-marcellus text-gray-900 leading-tight"
              >
                Authentic Ingredients
              </h3>
              <p class="text-xl text-slate/80 leading-relaxed font-sans italic">
                There are no compromises in our kitchen, only the pure taste of
                the Mediterranean. We import authentic PDO Feta, olives, and our
                extra virgin olive oil directly from Greece, to guarantee that
                unmistakable and genuine flavor.
              </p>
            </div>
          </div>

          <!-- Chapter 3: L'Incontro -->
          <div
            class="flex flex-col-reverse md:flex-row items-center gap-12 md:gap-24 group reveal-on-scroll"
          >
            <div
              class="w-full md:w-1/2 overflow-hidden rounded-3xl shadow-lg relative aspect-[4/3] border border-primary/5"
            >
              <Image
                src={imgMezze}
                alt="Conviviality and hospitality at the restaurant"
                class="w-full h-full object-cover scale-[1.03] transition-transform duration-1000 group-hover:scale-110"
              />
            </div>
            <div class="w-full md:w-1/2 space-y-6">
              <span
                class="text-accent font-bold tracking-widest uppercase text-sm mb-2 block font-marcellus"
                >Chapter III</span
              >
              <h3
                class="text-4xl md:text-5xl font-marcellus text-gray-900 leading-tight"
              >
                Conviviality
              </h3>
              <p class="text-xl text-slate/80 leading-relaxed font-sans italic">
                The heart of the Greek experience is being together. Crossing
                the threshold of Delogo in Cirenaica means sitting at a
                Mediterranean table: a glass of fragrant Retsina, food that is
                good for the soul, and time that slows down.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <StarDishes />
    <MenuAccordion />
    <div id="location">
      <div id="book">
        <LocationBlock />
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  // Reveal on scroll logic for home page consistency
  function initRevealOnScroll() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );

    document
      .querySelectorAll(".reveal-on-scroll")
      .forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:page-load", initRevealOnScroll);
</script>

<style is:global>
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }

  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
