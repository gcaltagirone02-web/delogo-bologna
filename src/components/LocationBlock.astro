---
const { currentLocale } = Astro;
const isIt = currentLocale === "it";
---

<section class="py-24 bg-paper reveal-on-scroll">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-24">
      <!-- Text / Contact Info Area -->
      <div class="w-full md:w-1/2 space-y-8 text-center md:text-left">
        <div>
          <span
            class="text-accent font-bold tracking-widest uppercase text-sm mb-2 block font-marcellus"
          >
            {isIt ? "La Posizione" : "Location"}
          </span>
          <h2
            class="text-4xl sm:text-5xl lg:text-6xl font-marcellus text-primary uppercase tracking-wider mb-6 leading-tight"
          >
            {isIt ? "Ti Aspettiamo" : "We are waiting"}
          </h2>
          <p class="text-xl text-slate/80 leading-relaxed font-sans italic">
            {
              isIt
                ? "Vieni a trovarci nel cuore di Bologna per scoprire l'autentica ospitalità greca."
                : "Come visit us in the heart of Bologna to discover authentic Greek hospitality."
            }
          </p>
        </div>

        <div class="flex justify-center md:justify-start mt-10">
          <div
            class="inline-flex flex-col sm:flex-row md:flex-col lg:flex-row items-start gap-8"
          >
            <!-- Address Info -->
            <div class="flex items-center sm:items-start gap-5 text-left">
              <div
                class="p-4 bg-accent/10 rounded-full text-accent shrink-0 flex items-center justify-center"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                  ></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="flex flex-col justify-center">
                <h4
                  class="font-bold text-accent text-xs tracking-[0.25em] uppercase mb-1 font-marcellus"
                >
                  {isIt ? "Indirizzo" : "Address"}
                </h4>
                <p class="text-slate font-sans leading-relaxed text-base">
                  Via Giovanna Zaccherini Alvisi 19/d,<br />40138 Bologna (BO)
                </p>
              </div>
            </div>

            <!-- Contact Info -->
            <div class="flex items-center sm:items-start gap-5 text-left">
              <div
                class="p-4 bg-accent/10 rounded-full text-accent shrink-0 flex items-center justify-center"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                  ></path>
                </svg>
              </div>
              <div class="flex flex-col justify-center">
                <h4
                  class="font-bold text-accent text-xs tracking-[0.25em] uppercase mb-1 font-marcellus"
                >
                  {isIt ? "Contatti" : "Contacts"}
                </h4>
                <a
                  href="tel:+39051245734"
                  class="text-slate hover:text-accent transition-colors block font-sans italic text-base"
                >
                  +39 051 245734
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="pt-8 flex justify-center md:justify-start">
          <a
            href="https://www.google.com/maps/dir/?api=1&destination=Via+Giovanna+Zaccherini+Alvisi+19/d,+40138+Bologna"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-10 py-4 bg-accent text-white rounded-full font-bold shadow-md hover:shadow-xl hover:-translate-y-1 hover:brightness-110 transition-all duration-300 transform"
          >
            {isIt ? "Ottieni Indicazioni" : "Get Directions"}
          </a>
        </div>
      </div>

      <!-- Map Area -->
      <div class="w-full md:w-1/2">
        <!-- Re-using identical styling logic from StarDishes & Bento Grid for coherence -->
        <div
          class="relative w-full aspect-square sm:aspect-video lg:aspect-[4/3] rounded-3xl overflow-hidden shadow-lg border border-primary/5 group"
        >
          <!-- Warm up overlay -->
          <div
            class="absolute inset-0 bg-accent/5 pointer-events-none z-10 transition-colors duration-500 group-hover:bg-transparent"
          >
          </div>

          <iframe
            title={isIt
              ? "Mappa di Google Maps per Delogo"
              : "Google Maps map for Delogo"}
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7003.640127094658!2d11.357331276663741!3d44.49623209749941!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x477fd4b1a786977f%3A0x741c9fc99a0464b1!2sDelogo%20-%20Cucina%20Greca!5e1!3m2!1sit!2sit!4v1771365193661!5m2!1sit!2sit"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full grayscale-[0.2] sepia-[0.1] contrast-[1.1] scale-[1.03] transition-transform duration-1000 group-hover:scale-100"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
