---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import MenuList from "../../components/MenuList.astro";

import { Image, getImage } from "astro:assets";
import imgMenuHeroDesktop from "../../asset/images/menu-hero-desktop.jpeg";
import imgMenuHeroMobile from "../../asset/images/menu-hero-mobile.jpeg";

const optimizedMenuDesktop = await getImage({
  src: imgMenuHeroDesktop,
  format: "webp",
  quality: 80,
  width: 1920,
  height: 1080,
});

const menuEntries = await getCollection("menu", ({ id }) => {
  return id.replace(/\\/g, "/").startsWith("en/");
});

menuEntries.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const { currentLocale } = Astro;
const isIt = currentLocale === "it" || currentLocale === undefined;

const title = isIt
  ? "Menù – Delogo Cucina Greca"
  : "Menu – Delogo Greek Cuisine";
const description = isIt
  ? "Scopri il nostro menù autentico: antipasti tipici, secondi piatti della tradizione e vini greci selezionati."
  : "Discover our authentic menu: traditional starters, classic main courses, and selected Greek wines.";

const introText = isIt
  ? "Dove i sapori dell'Egeo incontrano il calore di Bologna."
  : "Where the flavors of the Aegean meet the warmth of Bologna.";
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={optimizedMenuDesktop.src}
      media="(min-width: 768px)"
      fetchpriority="high"
    />
  </Fragment>
  <Header theme="transparent" />

  <main class="pb-16 md:pb-20 bg-paper" id="main-content">
    <div
      class="relative w-full min-h-[100svh] flex items-center justify-center overflow-hidden mb-12 md:mb-20"
    >
      <!-- Desktop Image -->
      <Image
        src={imgMenuHeroDesktop}
        alt="Atmosfera conviviale Delogo Desktop"
        width={1920}
        height={1080}
        format="webp"
        quality={80}
        class="absolute inset-0 w-full h-full object-cover hidden md:block"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Mobile Image -->
      <Image
        src={imgMenuHeroMobile}
        alt="Atmosfera conviviale Delogo Mobile"
        widths={[480, 800, 1080]}
        sizes="100vw"
        format="webp"
        quality={75}
        class="absolute inset-0 w-full h-full object-cover block md:hidden"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Dark Overlay for Readability -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/60 z-0"
      >
      </div>

      <!-- Bottom Seamless Fade Transition -->
      <div
        class="absolute bottom-0 left-0 w-full h-32 md:h-48 bg-gradient-to-b from-transparent to-paper pointer-events-none z-10"
      >
      </div>

      <div
        class="relative z-10 text-center px-4 sm:px-8 max-w-5xl mx-auto flex flex-col items-center mt-16 reveal-on-scroll"
      >
        <h1
          class="text-5xl md:text-7xl lg:text-8xl mb-4 z-10 relative font-marcellus leading-tight text-white drop-shadow-md"
        >
          {isIt ? "Il Menù" : "The Menu"}
        </h1>
        <p
          class="text-xl md:text-2xl lg:text-3xl font-serif font-medium max-w-none md:whitespace-nowrap leading-relaxed text-white/90 drop-shadow-md"
        >
          "{introText}"
        </p>
      </div>

      <!-- Elegant Scroll Indicator - Positioned relative to the 100vh Hero container -->
      <a
        href="#category-nav-wrapper"
        class="absolute bottom-10 md:bottom-16 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center justify-center text-white/90 hover:text-white transition-all duration-300 group outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-transparent p-4"
        aria-label={isIt
          ? "Scorri per vedere il menù"
          : "Scroll to see the menu"}
      >
        <span
          class="text-sm md:text-base tracking-[0.25em] uppercase font-marcellus mb-3 drop-shadow-lg"
          >{isIt ? "Esplora" : "Explore"}</span
        >
        <svg
          class="w-10 h-10 md:w-12 md:h-12 animate-bounce-soft drop-shadow-xl"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.2"
            d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Organic Category Navigation -->
      <nav
        id="category-nav-wrapper"
        class="sticky z-40 mb-10 md:mb-20 w-full transform-gpu scroll-fade-edges"
        style="top: calc(var(--header-h, 121px) + 4px); transition: top 500ms ease-in-out; will-change: top;"
        role="navigation"
        aria-label={isIt ? "Categorie menù" : "Menu Categories"}
      >
        <div
          class="py-3 md:py-4 flex justify-center items-center w-full bg-paper border-y border-primary/10 shadow-sm"
        >
          <div
            id="category-nav"
            class="flex gap-3 md:gap-4 overflow-x-auto hide-scrollbar max-w-full touch-pan-x scroll-smooth px-6 md:px-10 scroll-snap-x"
            style="-webkit-overflow-scrolling: touch;"
          >
            {
              menuEntries.map((entry, i) => (
                <a
                  href={`#${entry.data.title.toLowerCase().replace(/\s+/g, "-").replace(/&/g, "")}`}
                  class="category-pill font-marcellus uppercase tracking-widest text-[13px] md:text-sm whitespace-nowrap px-5 md:px-8 py-3 md:py-3.5 rounded-full flex items-center justify-center min-h-[44px] select-none snap-center transition-all duration-300"
                  data-category={entry.data.title
                    .toLowerCase()
                    .replace(/\s+/g, "-")
                    .replace(/&/g, "")}
                >
                  {isIt
                    ? entry.data.title
                    : entry.data.titleEn || entry.data.title}
                </a>
              ))
            }
          </div>
        </div>
      </nav>

      <div class="space-y-10 md:space-y-16">
        {
          menuEntries.map((entry) => (
            <MenuList
              id={entry.data.title
                .toLowerCase()
                .replace(/\s+/g, "-")
                .replace(/&/g, "")}
              title={
                isIt ? entry.data.title : entry.data.titleEn || entry.data.title
              }
              items={entry.data.items}
            />
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* Hide scrollbar on category nav */
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }

  /* ── Organic Navigation Styles ── */
  #category-nav-wrapper {
    /* Minimalist strip look */
  }

  .category-pill {
    color: var(--color-slate);
    opacity: 0.6;
  }

  .category-pill:hover {
    opacity: 1;
    color: var(--color-primary);
  }

  /* Organic Navigation Styles - Active Pill Blue */
  .category-pill.is-active {
    opacity: 1;
    color: white;
    background-color: #005a9c;
    border-radius: 68% 32% 44% 56% / 46% 52% 48% 54%;
    box-shadow: 0 4px 6px -1px rgba(0, 90, 156, 0.4);
  }

  /* ── Reveal on Scroll ── */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }

  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Elegant Hover / Scroll Indicator ── */
  @keyframes bounce-soft {
    0%,
    100% {
      transform: translateY(-10%);
      animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
    }
    50% {
      transform: translateY(10%);
      animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
    }
  }

  .animate-bounce-soft {
    animation: bounce-soft 2.5s infinite;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .category-pill,
    .reveal-on-scroll {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .animate-bounce-soft {
      animation: none !important;
    }
    html {
      scroll-behavior: auto !important;
    }
  }
</style>

<script>
  let headerMaxH = 121;
  let headerMinH = 70;

  // ── Pre-calculate exact heights for fluid 60fps animations ──
  function measureHeaderHeights() {
    const header = document.getElementById("main-header");
    if (!header) return;

    // Clone header to safely measure both states instantly without any visual flickering
    const clone = header.cloneNode(true) as HTMLElement;
    clone.style.visibility = "hidden";
    clone.style.position = "fixed";
    clone.style.transition = "none";

    // Disable transitions on all children of clone so we can measure the final state instantly
    const allElements = clone.querySelectorAll("*");
    allElements.forEach((el) => {
      (el as HTMLElement).style.transition = "none";
    });

    document.body.appendChild(clone);

    // Measure full size
    clone.classList.remove("is-scrolled");
    headerMaxH = clone.getBoundingClientRect().height;

    // Measure compact size
    clone.classList.add("is-scrolled");
    headerMinH = clone.getBoundingClientRect().height;

    document.body.removeChild(clone);
  }

  function applyHeaderHeights() {
    const header = document.getElementById("main-header");
    const spacer = document.getElementById("header-spacer");
    if (!header) return;

    if (spacer) {
      // Spacer always holds the max height to prevent page layout shifts
      const current = parseFloat(spacer.style.height) || 0;
      if (headerMaxH > current) spacer.style.height = `${headerMaxH}px`;
    }

    const isScrolled = header.classList.contains("is-scrolled");
    document.documentElement.style.setProperty(
      "--header-h",
      `${isScrolled ? headerMinH : headerMaxH}px`,
    );
  }

  function syncHeaderHeight() {
    const header = document.getElementById("main-header");
    if (!header) return;

    measureHeaderHeights();
    applyHeaderHeights();

    // Watch for class toggle to instantly set target height variable
    // Native CSS "transition: top 500ms ease-in-out" ensures zero JS layout-thrashing on scroll
    new MutationObserver(() => {
      applyHeaderHeights();
    }).observe(header, { attributes: true, attributeFilter: ["class"] });

    // Re-measure on orientation change / resize
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener(
      "resize",
      () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          measureHeaderHeights();
          applyHeaderHeights();
        }, 100);
      },
      { passive: true },
    );
  }

  // ── ScrollSpy: highlight the active category pill ──
  function initScrollSpy() {
    const pills =
      document.querySelectorAll<HTMLAnchorElement>(".category-pill");
    const nav = document.getElementById("category-nav");
    if (!pills.length || !nav) return;

    // Build section map from pills (preserves DOM order)
    const sections: HTMLElement[] = [];
    pills.forEach((pill) => {
      const id = pill.dataset.category;
      if (id) {
        const el = document.getElementById(id);
        if (el) sections.push(el);
      }
    });
    if (!sections.length) return;

    let currentActive: string | null = null;

    function setActive(id: string) {
      if (id === currentActive) return;
      currentActive = id;

      pills.forEach((pill) => {
        const isActive = pill.dataset.category === id;
        pill.classList.toggle("is-active", isActive);
        pill.setAttribute("aria-current", isActive ? "true" : "false");

        // Auto-scroll the active pill into view horizontally
        if (isActive && nav) {
          const navRect = nav.getBoundingClientRect();
          const scrollLeft =
            (pill as HTMLElement).offsetLeft -
            nav.offsetLeft -
            navRect.width / 2 +
            (pill as HTMLElement).offsetWidth / 2;
          nav.scrollTo({ left: scrollLeft, behavior: "smooth" });
        }
      });
    }

    // ── Position-based scroll-spy ──
    // Finds which section's top is closest to — but still above — a detection
    // line at 35% from the top of the viewport. Works reliably regardless of
    // section height (fixes IntersectionObserver miss on short sections like SECONDI).
    function findActiveSection(): string {
      const headerH =
        parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue(
            "--header-h",
          ),
        ) || 100;
      // Detection line: header bottom + half the remaining space
      const triggerY =
        window.scrollY + headerH + (window.innerHeight - headerH) * 0.25;

      let activeId = sections[0].id;
      for (const section of sections) {
        if (section.offsetTop <= triggerY) {
          activeId = section.id;
        }
      }
      return activeId;
    }

    // Update on scroll (throttled with requestAnimationFrame)
    let rafPending = false;
    function onScroll() {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => {
        setActive(findActiveSection());
        rafPending = false;
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });

    // Immediate feedback on pill click (don't wait for scroll)
    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const id = pill.dataset.category;
        if (id) setActive(id);
      });
    });

    // Set initial active state
    setActive(findActiveSection());
  }

  // ── Intersection Observer for Reveal ──
  function initRevealOnScroll() {
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.1,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          // Stop observing once visible to prevent re-triggering
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll(".reveal-on-scroll").forEach((el) => {
      observer.observe(el);
    });
  }

  // ── Initialization ──
  document.addEventListener("astro:page-load", () => {
    syncHeaderHeight();
    initScrollSpy();
    initRevealOnScroll();

    document.fonts.ready.then(() => {
      measureHeaderHeights();
      applyHeaderHeights();
    });
  });
</script>
