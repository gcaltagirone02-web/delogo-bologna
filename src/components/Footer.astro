---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import logoIcon from "../asset/images/delogo-ristorante-greco-bologna-logo.png";

const { currentLocale } = Astro;
const locale = currentLocale || "it";
const isIt = locale === "it";

const quickLinks = isIt
  ? [
      { label: "Home", href: getRelativeLocaleUrl(locale, "/") },
      { label: "Menù", href: getRelativeLocaleUrl(locale, "/menu") },
      {
        label: "Chi Siamo",
        href: getRelativeLocaleUrl(locale, "/") + "#chi-siamo",
      },
      {
        label: "Contatti",
        href: getRelativeLocaleUrl(locale, "/") + "#dove-siamo",
      },
    ]
  : [
      { label: "Home", href: getRelativeLocaleUrl(locale, "/") },
      { label: "Menu", href: getRelativeLocaleUrl(locale, "/menu") },
      {
        label: "About",
        href: getRelativeLocaleUrl(locale, "/") + "#chi-siamo",
      },
      {
        label: "Contact",
        href: getRelativeLocaleUrl(locale, "/") + "#dove-siamo",
      },
    ];

const legalLinks = isIt
  ? [
      { label: "Privacy Policy", href: "#" },
      { label: "Cookie Policy", href: "#" },
    ]
  : [
      { label: "Privacy Policy", href: "#" },
      { label: "Cookie Policy", href: "#" },
    ];

const openingHours = isIt
  ? [
      { day: "Lunedì", hours: "Chiuso", special: true },
      { day: "Mar – Ven", hours: "19:30 – 22:30" },
      { day: "Sabato", hours: "19:15 – 22:45" },
      { day: "Domenica", hours: "12:30 – 15:00 • 19:15 – 22:15" },
    ]
  : [
      { day: "Monday", hours: "Closed", special: true },
      { day: "Tue – Fri", hours: "19:30 – 22:30" },
      { day: "Saturday", hours: "19:15 – 22:45" },
      { day: "Sunday", hours: "12:30 – 15:00 • 19:15 – 22:15" },
    ];
---

<footer
  class="bg-[#2C1810] text-white pt-24 pb-12 mt-auto relative overflow-hidden font-sans"
>
  <!-- Texture overlay for brand consistency -->
  <div class="absolute inset-0 bg-paper opacity-[0.03] pointer-events-none">
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16 mb-20">
      <!-- Column 1: Brand & Info -->
      <div class="space-y-10">
        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <Image
              src={logoIcon}
              alt="Delogo Icon"
              class="w-10 h-auto brand-icon-gold drop-shadow-sm"
              width={40}
            />
            <div class="pt-0.5">
              <h3
                class="text-3xl font-normal tracking-normal mb-1 leading-none text-[#E6B943]"
                style="font-family: 'EB Garamond', serif;"
              >
                Delogo
              </h3>
              <p
                class="text-[11px] uppercase tracking-[0.3em] text-white/40 font-medium"
              >
                {
                  isIt
                    ? "Cucina Greca autentica · Bologna"
                    : "Authentic Greek Cuisine · Bologna"
                }
              </p>
            </div>
          </div>
        </div>

        <div class="space-y-8">
          <!-- Address & Contact -->
          <div class="space-y-4">
            <div class="flex items-start gap-3 text-white/70">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5 text-[#E6B943] shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                ></path><circle cx="12" cy="10" r="3"></circle></svg
              >
              <p class="text-sm leading-relaxed">
                Via Giovanna Zaccherini Alvisi 19/d,<br />
                40138 Bologna (BO)
              </p>
            </div>

            <div class="flex items-center gap-3 text-white/70">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-4.5 text-[#E6B943] shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path></svg
              >
              <a
                href="tel:+39051245734"
                class="text-sm hover:text-[#D14638] transition-colors duration-300 font-medium"
              >
                +39 051 245734
              </a>
            </div>
          </div>

          <!-- Social links with definition -->
          <div class="flex gap-4">
            <a
              href="https://www.instagram.com/delogobo/"
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon w-10 h-10 border border-[#E6B943]/30 rounded-full flex items-center justify-center text-white/70 hover:bg-[#E6B943] hover:text-[#2C1810] hover:border-[#E6B943] transition-all duration-300"
              aria-label="Instagram"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.441 1.441 1.441c.795 0 1.439-.645 1.439-1.441s-.644-1.44-1.439-1.44z"
                ></path></svg
              >
            </a>
            <a
              href="https://www.facebook.com/p/Delogo-100063802831770/"
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon w-10 h-10 border border-[#E6B943]/30 rounded-full flex items-center justify-center text-white/70 hover:bg-[#E6B943] hover:text-[#2C1810] hover:border-[#E6B943] transition-all duration-300"
              aria-label="Facebook"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                ><path
                  d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"
                ></path></svg
              >
            </a>
          </div>
        </div>
      </div>

      <!-- Column 2: Opening Hours -->
      <div class="space-y-8">
        <div>
          <h3
            class="font-marcellus text-[#E6B943] font-bold tracking-[0.2em] uppercase text-sm mb-4"
          >
            {isIt ? "Orari di Apertura" : "Opening Hours"}
          </h3>
          <div class="w-10 h-0.5 bg-[#E6B943]/30 rounded-full"></div>
        </div>

        <div class="grid grid-cols-1 gap-y-4">
          {
            openingHours.map((item) => (
              <div
                class={`flex justify-between items-center py-2 border-b border-white/5 last:border-0 ${item.special ? "opacity-50" : ""}`}
              >
                <span class="text-xs font-semibold uppercase tracking-wider text-white/60">
                  {item.day}
                </span>
                <span
                  class={`text-[13px] font-sans ${item.special ? "italic" : "font-medium text-white/90"}`}
                >
                  {item.hours}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Column 3: Navigation -->
      <div class="space-y-8 flex flex-col items-start w-full">
        <div class="w-full space-y-8 text-left">
          <div>
            <h3
              class="font-marcellus text-[#E6B943] font-bold tracking-[0.2em] uppercase text-sm mb-4"
            >
              {isIt ? "Navigazione" : "Navigation"}
            </h3>
            <div class="w-10 h-0.5 bg-[#E6B943]/30 rounded-full ml-0"></div>
          </div>
          <ul class="space-y-4">
            {
              quickLinks.map((link) => (
                <li class="flex justify-start">
                  <a
                    href={link.href}
                    class="nav-link relative font-serif font-medium text-lg tracking-wide text-white/70 hover:text-[#D14638] transition-all duration-300 group inline-block"
                  >
                    {link.label}
                    <span class="absolute left-0 -bottom-1 w-0 h-0.5 bg-[#D14638] transition-all duration-300 group-hover:w-full" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Copyright Bar -->
    <div
      class="pt-12 mt-12 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-6"
    >
      <div
        class="text-[10px] text-white/40 font-sans tracking-[0.2em] uppercase"
      >
        &copy; {new Date().getFullYear()} DELOGO – CUCINA GRECA.
      </div>

      <!-- Signature -->
      <div class="flex items-center gap-4">
        <span
          class="text-[16px] tracking-[0.3em] uppercase text-white/20 font-marcellus"
          >Crafted by</span
        >
        <a
          href="https://www.instagram.com/caltaa_/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-signature text-[#E6B943] text-5xl md:text-6xl opacity-70 hover:opacity-100 transition-all duration-300 hover:scale-110 hover:-translate-y-1 inline-block tracking-wider"
        >
          Calta
        </a>
      </div>

      <div class="flex gap-6">
        {
          legalLinks.map((link) => (
            <a
              href={link.href}
              class="text-[10px] text-white/40 hover:text-[#E6B943] transition-colors uppercase tracking-[0.1em] font-medium"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  /* Custom font for signature */
  .font-signature {
    font-family: "Mrs Saint Delafield", cursive;
    font-weight: 400;
  }

  .brand-icon-gold {
    filter: brightness(0) saturate(100%) invert(84%) sepia(31%) saturate(1209%)
      hue-rotate(338deg) brightness(96%) contrast(89%);
  }

  /* Sync with Header layout font if needed */
  .font-serif {
    font-family: "Marcellus", serif;
  }
</style>
