---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import StarDishes from "../components/StarDishes.astro";
import MenuAccordion from "../components/MenuAccordion.astro";
import LocationBlock from "../components/LocationBlock.astro";
import { Image } from "astro:assets";
import imgAegean from "../asset/images/aegean-view.png";
import imgMezze from "../asset/images/greek-mezze.png";
import imgChairs from "../asset/images/greek-chairs.png";
import imgHeroDesktop from "../asset/images/Delogo-Hero-fullscreen.jpeg";
import imgHeroMobile from "../asset/images/Delogo-Hero-Mobile-full.jpeg";

const title = "Delogo – Cucina Greca Autentica a Bologna";
const description =
  "Ristorante greco autentico nel cuore di Bologna, quartiere Cirenaica. Piatti tradizionali: Moussakas, Suvlaki, Tzatziki e molto altro.";

const optimizedDesktop = await getImage({
  src: imgHeroDesktop,
  format: "webp",
  quality: 80,
  width: 1920,
  height: 1080,
});
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={optimizedDesktop.src}
      media="(min-width: 768px)"
      fetchpriority="high"
    />
  </Fragment>
  <Header theme="transparent" />
  <main class="bg-paper" id="main-content">
    <Hero />

    <!-- USP Section: Perché Delogo (Bento Grid) -->
    <section id="chi-siamo" class="py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
          class="text-4xl md:text-6xl text-center mb-16 font-marcellus text-primary uppercase tracking-wider"
        >
          Un Assaggio di Egeo
        </h2>

        <div class="space-y-32 mt-20">
          <!-- Chapter 1: L'Origine -->
          <div
            class="flex flex-col-reverse md:flex-row items-center gap-12 md:gap-24 group reveal-on-scroll"
          >
            <div
              class="w-full md:w-1/2 overflow-hidden rounded-3xl shadow-lg relative aspect-[4/3] border border-primary/5"
            >
              <Image
                src={imgAegean}
                alt="I paesaggi e i sapori dell'Egeo"
                width={378}
                height={378}
                quality={50}
                format="webp"
                loading="lazy"
                class="w-full h-full object-cover scale-[1.03] transition-transform duration-1000 group-hover:scale-110"
              />
            </div>
            <div class="w-full md:w-1/2 space-y-6">
              <span
                class="text-accent font-bold tracking-widest uppercase text-sm mb-2 block font-marcellus"
                >Capitolo I</span
              >
              <h3
                class="text-4xl md:text-5xl font-marcellus text-gray-900 leading-tight"
              >
                La Nostra Filosofia
              </h3>
              <p class="text-xl text-slate/80 leading-relaxed font-sans italic">
                Portiamo a Bologna le ricette autentiche delle isole greche,
                dove abbiamo imparato che per mangiare bene servono sole, mare e
                dedizione. Vogliamo farti assaggiare la vera Grecia e la sua
                cultura dell'ospitalità, senza bisogno di prendere un aereo.
              </p>
            </div>
          </div>

          <!-- Chapter 2: Gli Ingredienti -->
          <div
            class="flex flex-col-reverse md:flex-row-reverse items-center gap-12 md:gap-24 group reveal-on-scroll"
          >
            <div
              class="w-full md:w-1/2 overflow-hidden rounded-3xl shadow-lg relative aspect-[4/3] border border-primary/5"
            >
              <Image
                src={imgChairs}
                alt="Atmosfera autentica greca"
                class="w-full h-full object-cover scale-[1.03] transition-transform duration-1000 group-hover:scale-110"
              />
            </div>
            <div class="w-full md:w-1/2 space-y-6 text-left md:text-right">
              <span
                class="text-accent font-bold tracking-widest uppercase text-sm mb-2 block font-marcellus"
                >Capitolo II</span
              >
              <h3
                class="text-4xl md:text-5xl font-marcellus text-gray-900 leading-tight"
              >
                Materia Prima Autentica
              </h3>
              <p class="text-xl text-slate/80 leading-relaxed font-sans italic">
                Non ci sono compromessi nella nostra cucina, solo il sapore puro
                del Mediterraneo. Facciamo arrivare la vera Feta DOP, le olive e
                il nostro olio extravergine direttamente dalla Grecia, per
                garantirti quel gusto inconfondibile e genuino.
              </p>
            </div>
          </div>

          <!-- Chapter 3: L'Incontro -->
          <div
            class="flex flex-col-reverse md:flex-row items-center gap-12 md:gap-24 group reveal-on-scroll"
          >
            <div
              class="w-full md:w-1/2 overflow-hidden rounded-3xl shadow-lg relative aspect-[4/3] border border-primary/5"
            >
              <Image
                src={imgMezze}
                alt="Convivialità e ospitalità al ristorante"
                class="w-full h-full object-cover scale-[1.03] transition-transform duration-1000 group-hover:scale-110"
              />
            </div>
            <div class="w-full md:w-1/2 space-y-6">
              <span
                class="text-accent font-bold tracking-widest uppercase text-sm mb-2 block font-marcellus"
                >Capitolo III</span
              >
              <h3
                class="text-4xl md:text-5xl font-marcellus text-gray-900 leading-tight"
              >
                La Convivialità
              </h3>
              <p class="text-xl text-slate/80 leading-relaxed font-sans italic">
                Il cuore dell'esperienza greca è lo stare insieme. Varcare la
                soglia di Delogo in Cirenaica significa sedersi a una tavola
                mediterranea: un bicchiere di Retsina profumata, cibo che fa
                bene all'anima e il tempo che rallenta.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <StarDishes />
    <MenuAccordion />
    <div id="dove-siamo">
      <div id="prenota">
        <LocationBlock />
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  // Reveal on scroll logic for home page consistency
  function initRevealOnScroll() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );

    document
      .querySelectorAll(".reveal-on-scroll")
      .forEach((el) => observer.observe(el));
  }

  document.addEventListener("astro:page-load", initRevealOnScroll);
</script>

<style is:global>
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }

  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
