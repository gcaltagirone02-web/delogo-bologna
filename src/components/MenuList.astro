---
import MenuCard from './MenuCard.astro';

interface MenuItem {
	id: string;
	name: string;
	description?: string;
	price: number;
	isStar: boolean;
}

interface Props {
	title: string;
	items: MenuItem[];
    id?: string;
}

const { title, items, id } = Astro.props;
---

<section id={id} class="py-16 md:py-32" style="scroll-margin-top: calc(var(--header-h, 100px) + 60px);" aria-labelledby={`heading-${id}`}>
    <div class="text-center mb-10 md:mb-20 relative">
        <h2 id={`heading-${id}`} class="text-4xl md:text-6xl font-marcellus text-accent tracking-wide relative z-10 inline-block px-4 md:px-6">
            {title}
            <!-- Subtle accent behind text -->
            <span class="absolute bottom-1 md:bottom-2 left-0 w-full h-3 md:h-4 bg-accent/10 -z-10 rounded-full transform -skew-x-12"></span>
        </h2>
        <!-- Decorative Separator -->
        <div class="flex items-center justify-center gap-4 md:gap-6 mt-4 md:mt-8 opacity-60">
            <div class="w-10 md:w-16 h-[1px] bg-primary/40"></div>
            <div class="w-2 md:w-3 h-2 md:h-3 rounded-full bg-accent/60"></div>
            <div class="w-10 md:w-16 h-[1px] bg-primary/40"></div>
        </div>
    </div>
	<div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 md:gap-x-12 gap-y-3 md:gap-y-10">
		{items.map(item => (
			<MenuCard 
				name={item.name}
				description={item.description}
				price={item.price}
				isStar={item.isStar}
			/>
		))}
	</div>
</section>
