---
interface Props {
  name: string;
  description?: string;
  price: number;
  isStar: boolean;
}

const { name, description, price, isStar } = Astro.props;

const { currentLocale } = Astro;
const recommendedLabel = currentLocale === 'en' ? 'Recommended' : 'Consigliato';
---

<div class={`group relative p-4 md:p-6 bg-transparent border-b border-primary/10 transition-all duration-300 hover:bg-white/40 active:scale-[0.99] ${isStar ? 'bg-accent/5' : ''}`}>
  {isStar && (
    <div class="absolute -top-3 left-4 bg-accent text-white text-[10px] md:text-[11px] font-marcellus px-3 md:px-4 py-1.5 rounded-full uppercase tracking-widest shadow-sm" aria-label={recommendedLabel}>
      {recommendedLabel}
    </div>
  )}
  
  <!-- Name + Price row -->
  <div class="flex justify-between items-baseline gap-3 md:gap-4">
    <h3 class={`font-marcellus text-slate group-hover:text-primary transition-colors duration-300 leading-tight ${isStar ? 'text-xl md:text-2xl' : 'text-lg md:text-xl'}`}>
      {name}
    </h3>
    <span class="text-lg md:text-xl font-marcellus text-primary whitespace-nowrap shrink-0">
      € {price.toFixed(2)}
    </span>
  </div>
  
  <!-- Description -->
  {description && (
    <p class="text-slate/80 text-sm md:text-base leading-relaxed font-sans mt-2 md:mt-4 pr-2 md:pr-4">
      {description}
    </p>
  )}

  <!-- Organic divider on hover -->
  <div class="mt-4 md:mt-6 flex justify-end opacity-0 group-hover:opacity-40 transition-opacity duration-300">
    <div class="w-12 h-[1px] bg-primary"></div>
  </div>
</div>
