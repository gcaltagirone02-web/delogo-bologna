---
interface Props {
  name: string;
  description?: string;
  price: number;
  isStar: boolean;
}

const { name, description, price } = Astro.props;
---

<div
  class="group relative p-4 md:p-6 bg-transparent border-b border-primary/10 transition-all duration-300 hover:bg-white/40 active:scale-[0.99]"
>
  <!-- Name + Price row -->
  <div class="flex justify-between items-baseline gap-3 md:gap-4">
    <h3
      class="font-marcellus text-slate group-hover:text-primary transition-colors duration-300 leading-tight text-lg md:text-xl"
    >
      {name}
    </h3>
    <span
      class="text-lg md:text-xl font-marcellus text-primary whitespace-nowrap shrink-0"
    >
      € {price.toFixed(2)}
    </span>
  </div>

  <!-- Description -->
  {
    description && (
      <p class="text-slate/80 text-sm md:text-base leading-relaxed font-sans mt-2 md:mt-4 pr-2 md:pr-4">
        {description}
      </p>
    )
  }

  <!-- Organic divider on hover -->
  <div
    class="mt-4 md:mt-6 flex justify-end opacity-0 group-hover:opacity-60 transition-all duration-500 transform translate-x-4 group-hover:translate-x-0"
  >
    <svg
      class="w-16 h-3 text-primary/40"
      viewBox="0 0 100 20"
      preserveAspectRatio="none"
    >
      <path
        d="M0 10 Q 15 2 30 10 T 60 10 T 100 10"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></path>
    </svg>
  </div>
</div>

<style>
  .group {
    /* Subtlest irregular edge to avoid perfect digital corners */
    clip-path: polygon(0.2% 0.5%, 99.8% 0%, 100% 99.5%, 0.5% 100%);
  }
</style>
