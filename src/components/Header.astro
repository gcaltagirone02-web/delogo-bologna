---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import logo from '../asset/images/delogo-ristorante-greco-bologna-logo.png';

interface Props {
  theme?: 'transparent' | 'dark' | 'menu';
  initialScrolled?: boolean;
}

const { currentLocale } = Astro;
const locale = currentLocale || 'it';
const isIt = locale === 'it';
const langLink = getRelativeLocaleUrl(isIt ? 'en' : 'it', '/');
const langLabel = isIt ? 'EN' : 'IT';
const { theme = 'transparent', initialScrolled = false } = Astro.props;

// Default classes based on theme
const textClass = (theme === 'dark' || theme === 'menu') ? 'text-[#005A9C]' : 'text-white';
const logoClass = (theme === 'dark' || theme === 'menu')
  ? 'w-12 md:w-20 h-auto object-contain transition-all duration-300 ease-in-out origin-left'
  : 'w-12 md:w-20 h-auto object-contain transition-all duration-300 ease-in-out brightness-0 invert origin-left';
// menu theme: starts solid white (no blur/shadow) — is-scrolled adds frosted blur + shadow on scroll
const bgClass = theme === 'dark'
  ? 'bg-white/90 backdrop-blur-md shadow-sm'
  : theme === 'menu'
    ? 'bg-white'
    : 'bg-transparent';

// Updated Nav Items per request
const navItems = isIt 
	? [
        { label: 'Menu', href: getRelativeLocaleUrl('it', '/menu') },
        { label: 'Chi Siamo', href: '#chi-siamo' },
        { label: 'Dove Siamo', href: '#dove-siamo' }
    ]
	: [
        { label: 'Menu', href: getRelativeLocaleUrl('en', '/menu') },
        { label: 'About', href: '#chi-siamo' },
        { label: 'Location', href: '#dove-siamo' }
    ];

// Menu categories for quick-links (when on /menu page)
const menuCategories = isIt
    ? [
        { label: 'Antipasti', id: 'antipasti' },
        { label: 'Insalate', id: 'insalate' },
        { label: 'Secondi', id: 'secondi' },
        { label: 'Contorni', id: 'contorni' },
        { label: 'Dolci', id: 'dolci' },
        { label: 'Vini', id: 'vini--bevande' },
    ]
    : [
        { label: 'Starters', id: 'antipasti' },
        { label: 'Salads', id: 'insalate' },
        { label: 'Mains', id: 'secondi' },
        { label: 'Sides', id: 'contorni' },
        { label: 'Desserts', id: 'dolci' },
        { label: 'Wines', id: 'vini--bevande' },
    ];
---

<header id="main-header" class={`fixed w-full top-0 z-[100] transition-all duration-500 ease-in-out${initialScrolled ? ' is-scrolled' : ''}`} data-theme={theme}>
    <!-- Background Layer -->
    <div id="header-bg" class={`absolute inset-0 transition-all duration-500 ease-in-out ${theme === 'dark' ? 'shadow-sm' : 'shadow-none'} ${bgClass}`}></div>

	<nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 md:py-8 flex justify-between items-center transition-all duration-500 relative z-[110]" id="nav-container">
		<!-- Logo -->
		<div class="flex items-center shrink-0">
			<a href={isIt ? '/' : '/en'} class="flex items-center gap-2 group select-none focus:outline-none transition-transform duration-300 hover:scale-105 hover:brightness-110" aria-label="Delogo - Home">
				<Image 
					src={logo} 
					alt="Delogo - Ristorante Greco Bologna" 
					id="header-logo"
					class={logoClass}
                    loading="eager"
                    fetchpriority="high"
				/>
                <span id="brand-name" class={`font-brand font-semibold text-3xl md:text-5xl normal-case leading-none mt-1 transition-all duration-300 ease-in-out origin-left ${textClass}`}>
                    Delogo
                </span>
			</a>
		</div>
		
		<!-- Desktop Nav -->
		<div class="hidden lg:flex items-center gap-6 xl:gap-8">
			{navItems.map(item => (
				<a href={item.href} class={`nav-link relative font-serif font-medium text-lg tracking-wide hover:text-[#D14638] transition-all duration-300 group ${textClass}`}>
					{item.label}
                    <span class="absolute left-0 -bottom-1 w-0 h-0.5 bg-[#D14638] transition-all duration-300 group-hover:w-full"></span>
				</a>
			))}
            
            <!-- Language Switcher -->
			<a href={langLink} 
               class={`nav-link text-sm font-bold hover:text-[#D14638] transition-all duration-300 ml-2 xl:ml-4 uppercase tracking-widest ${textClass}`}
               aria-label={isIt ? "Switch to English" : "Cambia lingua in Italiano"}>
				{langLabel}
			</a>

            <!-- CTA Button -->
            <a href="#prenota" class="ml-2 xl:ml-4 bg-[#D14638] text-white px-6 xl:px-8 py-3 rounded-full font-bold shadow-lg hover:bg-[#a33429] hover:scale-105 hover:shadow-xl transition-all duration-300">
                {isIt ? 'Prenota' : 'Book Now'}
            </a>
		</div>

		<!-- Mobile Menu Button (min 48x48 touch target) -->
		<button id="mobile-menu-btn" class={`lg:hidden p-3 z-[120] relative focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4B9CD3] focus-visible:ring-offset-2 rounded-lg transition-all duration-300 min-w-[48px] min-h-[48px] flex items-center justify-center ${(theme === 'dark' || theme === 'menu') ? 'text-[#005A9C]' : 'text-white'}`} aria-label="Apri menù di navigazione" aria-expanded="false" aria-controls="mobile-menu">
            <div class="w-7 h-5 flex flex-col justify-between relative">
                <span class="w-full h-0.5 bg-current transform transition-all duration-300 origin-center top-0 absolute"></span>
                <span class="w-full h-0.5 bg-current transform transition-all duration-300 top-[9px] absolute"></span>
                <span class="w-full h-0.5 bg-current transform transition-all duration-300 origin-center bottom-0 absolute"></span>
            </div>
		</button>
	</nav>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 bg-[#F9F9F7] z-[105] transform translate-x-full transition-transform duration-500 ease-in-out flex flex-col lg:hidden pt-24 px-6 overflow-y-auto" aria-hidden="true" role="dialog" aria-label="Menu di navigazione">
        <div class="flex flex-col w-full max-w-sm mx-auto py-8 flex-1">
            <!-- Main Nav Links -->
            <div class="flex flex-col space-y-6 text-center">
                {navItems.map((item, i) => (
                    <a 
                        href={item.href} 
                        class="text-3xl font-serif font-bold text-[#005A9C] hover:text-[#D14638] transition-colors mobile-link opacity-0"
                        style={`animation-delay: ${i * 80}ms;`}
                    >
                        {item.label}
                    </a>
                ))}
            </div>

            <!-- Category Quick-links (visible only on /menu) -->
            <div id="mobile-menu-categories" class="mt-8 pt-6 border-t border-gray-200 hidden">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#2F4F4F]/50 text-center mb-4">
                    {isIt ? 'Vai alla sezione' : 'Jump to section'}
                </p>
                <div class="flex flex-wrap justify-center gap-2">
                    {menuCategories.map((cat, i) => (
                        <a
                            href={`#${cat.id}`}
                            class="mobile-link mobile-cat-link text-sm font-bold text-[#2F4F4F] bg-white border border-gray-200 px-4 py-2.5 rounded-full hover:bg-primary hover:text-white hover:border-primary transition-all duration-200 min-h-[44px] flex items-center opacity-0"
                            style={`animation-delay: ${(navItems.length + i) * 80}ms;`}
                        >
                            {cat.label}
                        </a>
                    ))}
                </div>
            </div>

            <!-- Language Switcher -->
            <a href={langLink} class="text-base font-bold text-gray-400 hover:text-[#005A9C] transition-colors mt-8 uppercase tracking-widest text-center mobile-link opacity-0" style={`animation-delay: ${(navItems.length + menuCategories.length) * 80}ms;`}>
				{isIt ? 'English Version' : 'Versione Italiana'}
			</a>

            <!-- CTA -->
            <div class="mt-auto pt-8 pb-8 text-center">
                <a href="#prenota" class="bg-[#D14638] text-white px-10 py-4 rounded-full text-xl font-bold shadow-xl mobile-link transform hover:scale-105 transition-transform inline-block opacity-0" style={`animation-delay: ${(navItems.length + menuCategories.length + 1) * 80}ms;`}>
                    {isIt ? 'Prenota un Tavolo' : 'Book a Table'}
                </a>
            </div>
        </div>
    </div>
</header>

<style is:global>
    /* Scrolled State Styles */
    #main-header.is-scrolled #header-bg {
        background-color: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    }

    #main-header.is-scrolled #nav-container {
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
    }

    /* Logo Reduction - Mobile First (w-10 = 2.5rem) */
    #main-header.is-scrolled #header-logo {
        width: 2.5rem;
        filter: brightness(1) invert(0);
    }

    /* Logo Reduction - Desktop (w-12 = 3rem) */
    @media (min-width: 768px) {
        #main-header.is-scrolled #header-logo {
            width: 3rem;
        }
    }

    /* Text Reduction - Mobile First (text-2xl = 1.5rem) */
    #main-header.is-scrolled #brand-name {
        font-size: 1.5rem;
        color: #005A9C;
    }

    /* Text Reduction - Desktop (text-2xl = 1.5rem) */
    @media (min-width: 768px) {
        #main-header.is-scrolled #brand-name {
            font-size: 1.5rem;
        }
    }

    #main-header.is-scrolled .nav-link,
    #main-header.is-scrolled #mobile-menu-btn {
        color: #005A9C;
    }

    /* Mobile Menu Open State */
    #main-header.menu-open #header-bg {
        background-color: white !important;
        opacity: 1 !important;
    }

    #main-header.menu-open #header-logo {
        width: 2.5rem; /* w-10 */
        filter: brightness(1) invert(0);
    }

    #main-header.menu-open #brand-name {
        font-size: 1.5rem; /* text-2xl */
        color: #005A9C;
    }

    #main-header.menu-open #mobile-menu-btn {
        color: #005A9C;
    }

    /* Stagger animation for mobile menu links */
    @keyframes menu-link-enter {
        from {
            opacity: 0;
            transform: translateY(16px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    #main-header.menu-open .mobile-link {
        animation: menu-link-enter 0.4s ease-out forwards;
    }

    /* Reset animation when menu is closed */
    #mobile-menu.translate-x-full .mobile-link {
        opacity: 0;
        animation: none;
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        #main-header.menu-open .mobile-link {
            animation: none !important;
            opacity: 1 !important;
        }
        #mobile-menu {
            transition: none !important;
        }
    }
</style>

<script>
    const header = document.getElementById('main-header');
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const spans = mobileBtn?.querySelectorAll('span');
    const categoriesSection = document.getElementById('mobile-menu-categories');

    // Show category quick-links only on /menu page
    const isMenuPage = window.location.pathname.includes('/menu');
    if (isMenuPage && categoriesSection) {
        categoriesSection.classList.remove('hidden');
    }

    // Scroll Effect
    function handleScroll() {
        if (window.scrollY > 50) {
            header?.classList.add('is-scrolled');
        } else {
            header?.classList.remove('is-scrolled');
        }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Initial check

    // Mobile Menu Toggle
    let isMenuOpen = false;

    function closeMenu() {
        isMenuOpen = false;
        mobileMenu?.classList.add('translate-x-full');
        mobileMenu?.setAttribute('aria-hidden', 'true');
        header?.classList.remove('menu-open');
        mobileBtn?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';

        // Icon Animation (Reset)
        if (spans && spans.length === 3) {
            spans[0].classList.remove('rotate-45', 'top-[9px]');
            spans[0].classList.add('top-0');
            spans[1].classList.remove('opacity-0');
            spans[2].classList.remove('-rotate-45', 'top-[9px]');
            spans[2].classList.add('bottom-0');
        }
    }

    function openMenu() {
        isMenuOpen = true;
        mobileMenu?.classList.remove('translate-x-full');
        mobileMenu?.setAttribute('aria-hidden', 'false');
        header?.classList.add('menu-open');
        mobileBtn?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';

        // Icon Animation (X)
        if (spans && spans.length === 3) {
            spans[0].classList.remove('top-0');
            spans[0].classList.add('rotate-45', 'top-[9px]');
            spans[1].classList.add('opacity-0');
            spans[2].classList.remove('bottom-0');
            spans[2].classList.add('-rotate-45', 'top-[9px]');
        }
    }

    mobileBtn?.addEventListener('click', () => {
        if (isMenuOpen) {
            closeMenu();
        } else {
            openMenu();
        }
    });

    // Close menu on link click
    mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
             if (isMenuOpen) {
                closeMenu();
             }
        });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isMenuOpen) {
            closeMenu();
            mobileBtn?.focus();
        }
    });
</script>
