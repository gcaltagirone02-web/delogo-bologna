---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MenuList from '../../components/MenuList.astro';

const menuEntries = await getCollection('menu', ({ id }) => {
  return id.replace(/\\/g, '/').startsWith('en/');
});
menuEntries.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const title = "Menu – Delogo Greek Cuisine";
const description = "Explore our authentic menu: traditional appetizers, main courses, and selected Greek wines.";
---

<Layout title={title} description={description}>
	<Header theme="dark" />
	<main class="pt-32 pb-20 md:pt-40 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-10">
				<h1 class="text-4xl md:text-5xl mb-4">Our Menu</h1>
				<p class="text-[#2F4F4F] italic">"The essence of Greece in every dish"</p>
			</div>
			
            <!-- Floating Category Navigation -->
            <div class="sticky top-[90px] md:top-[120px] z-40 mb-16 flex justify-center items-center w-full px-2 pointer-events-none -mt-4">
                <div class="pointer-events-auto bg-white/95 backdrop-blur-xl shadow-xl shadow-primary/5 border border-gray-100 rounded-full p-2 overflow-x-auto hide-scrollbar max-w-[98%] sm:max-w-full touch-pan-x hover:shadow-2xl transition-shadow duration-300">
                    <div class="flex items-center gap-2 min-w-max">
                        {menuEntries.map(entry => (
                            <a 
                                href={`#${entry.data.title.toLowerCase().replace(/\s+/g, '-')}`}
                                class="text-[#2F4F4F] font-bold uppercase tracking-wider text-xs md:text-sm whitespace-nowrap px-5 md:px-6 py-3 md:py-3 rounded-full hover:bg-primary hover:text-white transition-all duration-300 transform active:scale-95 flex items-center justify-center"
                            >
                                {entry.data.title}
                            </a>
                        ))}
                    </div>
                </div>
            </div>

			<div class="space-y-16">
				{menuEntries.map(entry => (
					<MenuList 
                        id={entry.data.title.toLowerCase().replace(/\s+/g, '-')}
                        title={entry.data.title} 
                        items={entry.data.items} 
                    />
				))}
			</div>
		</div>
	</main>
	<Footer />
</Layout>
