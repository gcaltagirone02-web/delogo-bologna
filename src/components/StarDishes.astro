---
import { Image } from 'astro:assets';
import imgMoussakas from '../asset/images/Moussakas.jpeg';
import imgSuvlaki from '../asset/images/suvlaki.jpeg';

const { currentLocale } = Astro;
const isIt = currentLocale === "it";

const dishes = [
	{
		name: "Moussakas",
		price: "€ 12,00",
		description: isIt ? "Il grande classico. Strati generosi di melanzane e patate, un ricco ragù della tradizione e una morbida besciamella dorata al forno. Servito caldissimo." : "The great classic. Generous layers of eggplant and potatoes, a rich traditional meat sauce and a soft golden baked bechamel. Served hot.",
		image: imgMoussakas,
		alt: isIt ? "Moussakas tradizionale greca con strati di melanzane e besciamella dorata" : "Traditional Greek Moussakas with layers of eggplant and golden bechamel"
	},
	{
		name: "Suvlaki",
		price: "€ 12,00",
		description: isIt ? "Spiedini di tenero maiale marinati nelle erbe greche, cotti sul fuoco alla perfezione. Li serviamo con il nostro tzatziki fresco e denso per un contrasto perfetto." : "Tender pork skewers marinated in Greek herbs, cooked over the fire to perfection. We serve them with our fresh and thick tzatziki for a perfect contrast.",
		image: imgSuvlaki,
		alt: isIt ? "Suvlaki di maiale tenero servito con salsa tzatziki fresca e insalata" : "Tender pork suvlaki served with fresh tzatziki sauce and salad"
	}
];
---

<section class="py-24 bg-paper reveal-on-scroll">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<h2 class="text-4xl md:text-6xl text-center mb-16 font-marcellus text-primary uppercase tracking-wider">{isIt ? "I Sapori di Creta" : "The Flavors of Crete"}</h2>
		</div>

		<div class="space-y-32">
			{dishes.map((dish, index) => (
				<div class={`flex flex-col ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} items-center gap-6 md:gap-24 group/card`}>
					<!-- Mobile Title (Hidden on desktop) -->
					<div class="w-full text-center px-4 sm:px-0 md:hidden mb-2">
						<div class="inline-block text-accent font-bold tracking-widest uppercase text-sm mb-2 font-marcellus">{isIt ? "Le Specialità" : "The Specialties"}</div>
						<h3 class="text-4xl font-marcellus text-gray-900 leading-tight">{dish.name}</h3>
					</div>

					<!-- Image -->
					<div class="w-full md:w-1/2 px-4 sm:px-0">
						<div class="relative aspect-video md:aspect-[4/3] overflow-hidden rounded-3xl shadow-lg group border border-primary/5">
							{typeof dish.image === 'string' ? (
								<Image 
									src={dish.image} 
									alt={dish.alt} 
									width={1200} 
									height={900} 
									loading="lazy"
									fetchpriority="low"
									class="w-full h-full object-cover scale-[1.03] transition-transform duration-1000 group-hover:scale-110" 
								/>
							) : (
								<Image 
									src={dish.image} 
									alt={dish.alt} 
									loading="lazy"
									fetchpriority="low"
									class="w-full h-full object-cover scale-[1.03] transition-transform duration-1000 group-hover:scale-110" 
								/>
							)}
						</div>
					</div>
					
					<!-- Content -->
					<div class="w-full md:w-1/2 flex flex-col items-center md:items-start text-center md:text-left px-4 sm:px-0 mt-2 md:mt-0">
						<!-- Desktop Title (Hidden on mobile) -->
						<div class="hidden md:block mb-6">
							<div class="inline-block text-accent font-bold tracking-widest uppercase text-sm mb-2 font-marcellus">{isIt ? "Le Specialità" : "The Specialties"}</div>
							<h3 class="text-4xl md:text-5xl font-marcellus text-gray-900 leading-tight">{dish.name}</h3>
						</div>
						
						<!-- Description & Price Section -->
						<div class="w-full">
							<p class="text-xl text-slate/80 leading-relaxed font-sans italic">
								{dish.description}
							</p>
							<div class="flex flex-col justify-start items-center md:items-start gap-6 pt-6">
								<span class="text-3xl font-marcellus text-gray-900 font-medium">{dish.price}</span>
								<a href="#prenota" class="inline-block bg-primary text-white px-10 py-4 rounded-full font-bold transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-1">
									{isIt ? "Prenota e Assaggia" : "Book and Taste"}
								</a>
							</div>
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
