---
import { Image } from 'astro:assets';

const dishes = [
	{
		name: "Moussakas",
		price: "€ 12,00",
		description: "Il grande classico. Strati generosi di melanzane e patate, un ricco ragù della tradizione e una morbida besciamella dorata al forno. Servito caldissimo.",
		image: "https://images.unsplash.com/photo-1512621776951-a57141f2eefd?q=80&w=2070&auto=format&fit=crop",
		alt: "Moussakas tradizionale greca con strati di melanzane e besciamella dorata"
	},
	{
		name: "Suvlaki",
		price: "€ 12,00",
		description: "Spiedini di tenero maiale marinati nelle erbe greche, cotti sul fuoco alla perfezione. Li serviamo con il nostro tzatziki fresco e denso per un contrasto perfetto.",
		image: "https://images.unsplash.com/photo-1623341214825-9f4f963727da?q=80&w=2070&auto=format&fit=crop",
		alt: "Suvlaki di maiale tenero servito con salsa tzatziki fresca e insalata"
	}
];
---

<section class="py-24 bg-white overflow-hidden">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="text-center mb-20">
			<h2 class="text-5xl font-serif font-bold text-primary mb-4">I Sapori di Creta</h2>
			<div class="w-16 h-1 bg-accent mx-auto"></div>
		</div>

		<div class="space-y-32">
			{dishes.map((dish, index) => (
				<div class={`flex flex-col ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} items-center gap-12 md:gap-24 group/card`}>
					<!-- Image: Full bleed on mobile -->
					<div class="w-full md:w-1/2 -mx-4 md:mx-0">
						<div class="relative aspect-video md:aspect-[4/3] overflow-hidden md:rounded-3xl shadow-xl group cursor-pointer">
							<Image 
								src={dish.image} 
								alt={dish.alt} 
								width={1200} 
								height={900} 
								loading="lazy"
								fetchpriority="low"
								class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" 
							/>
							<div class="absolute inset-0 bg-black/5 transition-colors duration-300 group-hover:bg-black/0"></div>
						</div>
					</div>
					
					<!-- Content -->
					<div class="w-full md:w-1/2 space-y-6 text-center md:text-left transition-all duration-300">
						<div class="inline-block text-accent font-bold tracking-widest uppercase text-sm mb-2">Le Specialità</div>
						<h3 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 leading-tight">{dish.name}</h3>
						<p class="text-xl text-gray-600 leading-relaxed font-sans">
							{dish.description}
						</p>
                        <div class="flex flex-col justify-start items-center md:items-start gap-6 pt-4">
                            <span class="text-3xl font-serif text-gray-900 font-medium">{dish.price}</span>
                            <a href="#prenota" class="inline-block bg-primary text-white px-8 py-3 rounded-full font-bold transition-all duration-300 shadow-md hover:shadow-xl hover:-translate-y-1">
                                Prenota e Assaggia
                            </a>
                        </div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
